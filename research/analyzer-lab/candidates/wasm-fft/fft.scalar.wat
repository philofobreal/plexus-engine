;; Exact radix-2 reference transform: f64 expressions, f32 array stores.
(module
  (import "env" "memory" (memory 1 12))
  (func $read (param $p i32) (result f64)
    (f64.promote_f32 (f32.load (local.get $p))))
  (func $write (param $p i32) (param $v f64)
    (f32.store (local.get $p) (f32.demote_f64 (local.get $v))))
  (func (export "transform") (param $n i32)
    (local $i i32) (local $j i32) (local $k i32)
    (local $stage i32) (local $half i32) (local $step i32)
    (local $ip i32) (local $jp i32) (local $hp i32) (local $ib i32)
    (local $c f64) (local $s f64) (local $tr f64) (local $ti f64)
    (local $r f64) (local $v f64) (local $hr f64) (local $hi f64)
    (if (i32.or (i32.or (i32.lt_u (local.get $n) (i32.const 2))
                        (i32.gt_u (local.get $n) (i32.const 65536)))
                (i32.or (i32.ne (i32.and (local.get $n) (i32.sub (local.get $n) (i32.const 1))) (i32.const 0))
                        (i32.gt_u (i32.mul (local.get $n) (i32.const 12)) (i32.shl (memory.size) (i32.const 16)))))
      (then unreachable))
    (local.set $ib (i32.shl (local.get $n) (i32.const 2)))
    (block $bitdone (loop $bits
      (br_if $bitdone (i32.ge_u (local.get $i) (i32.sub (local.get $n) (i32.const 1))))
      (if (i32.lt_u (local.get $i) (local.get $j)) (then
        (local.set $ip (i32.shl (local.get $i) (i32.const 2)))
        (local.set $jp (i32.shl (local.get $j) (i32.const 2)))
        (local.set $tr (call $read (local.get $jp)))
        (local.set $ti (call $read (i32.add (local.get $ib) (local.get $jp))))
        (call $write (local.get $jp) (call $read (local.get $ip)))
        (call $write (i32.add (local.get $ib) (local.get $jp)) (call $read (i32.add (local.get $ib) (local.get $ip))))
        (call $write (local.get $ip) (local.get $tr))
        (call $write (i32.add (local.get $ib) (local.get $ip)) (local.get $ti))))
      (local.set $k (i32.shr_u (local.get $n) (i32.const 1)))
      (block $carrydone (loop $carry
        (br_if $carrydone (i32.gt_u (local.get $k) (local.get $j)))
        (local.set $j (i32.sub (local.get $j) (local.get $k)))
        (local.set $k (i32.shr_u (local.get $k) (i32.const 1))) (br $carry)))
      (local.set $j (i32.add (local.get $j) (local.get $k)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $bits)))
    (local.set $stage (i32.const 2))
    (block $done (loop $stages
      (br_if $done (i32.gt_u (local.get $stage) (local.get $n)))
      (local.set $half (i32.shr_u (local.get $stage) (i32.const 1)))
      (local.set $step (i32.div_u (local.get $n) (local.get $stage)))
      (local.set $i (i32.const 0))
      (block $groupsdone (loop $groups
        (br_if $groupsdone (i32.ge_u (local.get $i) (local.get $n)))
        (local.set $j (local.get $i)) (local.set $k (i32.const 0))
        (block $butterdone (loop $butter
          (br_if $butterdone (i32.ge_u (local.get $j) (i32.add (local.get $i) (local.get $half))))
          (local.set $ip (i32.shl (local.get $j) (i32.const 2)))
          (local.set $hp (i32.shl (i32.add (local.get $j) (local.get $half)) (i32.const 2)))
          (local.set $c (call $read (i32.add (i32.shl (local.get $n) (i32.const 3)) (i32.shl (local.get $k) (i32.const 2)))))
          (local.set $s (call $read (i32.add (i32.mul (local.get $n) (i32.const 10)) (i32.shl (local.get $k) (i32.const 2)))))
          (local.set $r (call $read (local.get $ip)))
          (local.set $v (call $read (i32.add (local.get $ib) (local.get $ip))))
          (local.set $hr (call $read (local.get $hp)))
          (local.set $hi (call $read (i32.add (local.get $ib) (local.get $hp))))
          (local.set $tr (f64.sub (f64.mul (local.get $hr) (local.get $c)) (f64.mul (local.get $hi) (local.get $s))))
          (local.set $ti (f64.add (f64.mul (local.get $hr) (local.get $s)) (f64.mul (local.get $hi) (local.get $c))))
          (call $write (local.get $hp) (f64.sub (local.get $r) (local.get $tr)))
          (call $write (i32.add (local.get $ib) (local.get $hp)) (f64.sub (local.get $v) (local.get $ti)))
          (call $write (local.get $ip) (f64.add (local.get $r) (local.get $tr)))
          (call $write (i32.add (local.get $ib) (local.get $ip)) (f64.add (local.get $v) (local.get $ti)))
          (local.set $j (i32.add (local.get $j) (i32.const 1)))
          (local.set $k (i32.add (local.get $k) (local.get $step))) (br $butter)))
        (local.set $i (i32.add (local.get $i) (local.get $stage))) (br $groups)))
      (local.set $stage (i32.shl (local.get $stage) (i32.const 1))) (br $stages))))
)
