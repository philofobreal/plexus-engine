{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plexus.local/research/run-manifest/1.0.0",
  "title": "run-manifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reproducibilityHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "track": {
      "type": "object",
      "properties": {
        "trackId": {
          "type": "string"
        },
        "contentHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "monoProjection": {
          "type": "string"
        },
        "decodedPcmHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "trackId",
        "contentHash",
        "duration",
        "sampleRate"
      ],
      "additionalProperties": false
    },
    "configHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "config": {
      "type": "object"
    },
    "plexusCommit": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "schemaVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "environment": {
      "type": "object"
    },
    "randomSeeds": {
      "type": "object"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": {
            "enum": [
              "success",
              "failed",
              "unavailable",
              "disabled"
            ]
          },
          "reason": {
            "type": "string"
          },
          "canonical": {
            "type": "string"
          },
          "raw": {
            "type": "string"
          },
          "toolVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelIdentifier": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelVersion": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "modelChecksum": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "parameters": {
            "type": "object"
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ]
          },
          "stderr": {
            "type": "string"
          },
          "providerDiagnostics": {},
          "elapsedSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": true
      }
    },
    "dataset": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "datasetId": {
              "type": "string"
            },
            "datasetVersion": {
              "type": "string"
            },
            "split": {
              "enum": [
                "train",
                "validation",
                "test"
              ]
            },
            "license": {
              "type": "string"
            },
            "licenseSource": {
              "type": "string"
            },
            "allowedResearchUsage": {
              "type": "string"
            }
          },
          "required": [
            "datasetId",
            "datasetVersion",
            "split",
            "license",
            "licenseSource",
            "allowedResearchUsage"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "reproducibilityHash",
    "track",
    "configHash",
    "config",
    "plexusCommit",
    "timestamp",
    "schemaVersions",
    "environment",
    "randomSeeds",
    "providers",
    "dataset"
  ],
  "additionalProperties": false
}
