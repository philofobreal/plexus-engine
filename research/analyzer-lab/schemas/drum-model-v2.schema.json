{
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "plexus-drum-ridge-v2"
    },
    "classes": {
      "const": [
        "kick",
        "snare",
        "hihat"
      ]
    },
    "featureVersion": {
      "type": "string",
      "minLength": 1
    },
    "featureNames": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 30,
      "maxItems": 30
    },
    "mean": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 30,
      "maxItems": 30
    },
    "scale": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 30,
      "maxItems": 30
    },
    "weights": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 3,
        "maxItems": 3
      },
      "minItems": 43,
      "maxItems": 43
    },
    "thresholds": {
      "type": "array",
      "items": {
        "type": "number",
        "enum": [
          -0.25,
          -0.2,
          -0.15,
