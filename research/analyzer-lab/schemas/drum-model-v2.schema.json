        "proposal_contrast_1200_4000",
        "proposal_contrast_4000_11025",
        "log_power_20_180*attack_20_180",
        "log_power_180_1200*attack_180_1200",
        "log_power_1200_4000*attack_1200_4000",
        "log_power_4000_11025*attack_4000_11025",
        "power_share_20_180*novelty_20_180",
        "power_share_180_1200*novelty_180_1200",
        "power_share_1200_4000*novelty_1200_4000",
        "power_share_4000_11025*novelty_4000_11025",
        "tonal_concentration*log_power_20_180",
        "tonal_concentration*log_power_180_1200",
        "tonal_concentration*log_power_1200_4000",
        "tonal_concentration*log_power_4000_11025"
      ]
    },
    "hyperparameterSelection": {
      "type": "object",
      "properties": {
        "split": {
          "const": "validation"
        },
        "ridgeGrid": {
          "const": [
            1.0,
            10.0,
            100.0
          ]
        },
        "trials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ridgeTrial"
          },
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true
        },
        "rule": {
          "const": "macro class event F, worst class F, macro precision, higher ridge"
        }
      },
      "required": [
        "split",
        "ridgeGrid",
        "trials",
        "rule"
      ],
      "additionalProperties": false
    }
