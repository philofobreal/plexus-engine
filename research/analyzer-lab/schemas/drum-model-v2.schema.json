      "const": 0.03
    },
    "matchTolerance": {
      "const": 0.05
    },
    "minSeparation": {
      "const": 0.05
    },
    "scoreMeaning": {
      "type": "string",
      "minLength": 1
    },
    "validationSelection": {
      "type": "object",
      "properties": {
        "rule": {
          "const": "maximize micro event F, then precision, then higher threshold"
        },
        "thresholdGrid": {
          "const": [
            -0.25,
            -0.2,
            -0.15,
            -0.09999999999999998,
            -0.04999999999999999,
            0.0,
            0.050000000000000044,
            0.10000000000000003,
            0.15000000000000002,
            0.2,
            0.25,
            0.30000000000000004,
            0.3500000000000001,
            0.4,
            0.45000000000000007,
            0.5,
