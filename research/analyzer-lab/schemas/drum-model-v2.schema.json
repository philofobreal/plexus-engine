            1.25,
            1.3,
            1.35,
            1.4000000000000001,
            1.4500000000000002,
            1.5
          ]
        },
        "byClass": {
          "type": "object",
          "properties": {
            "kick": {
              "$ref": "#/$defs/validationClassMetric"
            },
            "snare": {
              "$ref": "#/$defs/validationClassMetric"
            },
            "hihat": {
              "$ref": "#/$defs/validationClassMetric"
            }
          },
          "required": [
            "kick",
            "snare",
            "hihat"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "rule",
        "thresholdGrid",
        "byClass"
      ],
      "additionalProperties": false
    },
    "fitting": {
      "type": "object",
      "properties": {
        "datasetId": {
          "type": "string",
          "minLength": 1
        },
        "rights": {
          "type": "object",
          "properties": {
            "reviewed": {
              "const": true
            },
            "trainingAllowed": {
              "const": true
            },
            "evaluationAllowed": {
              "const": true
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": "string",
              "minLength": 1
            },
            "reviewNote": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "reviewed",
            "trainingAllowed",
            "evaluationAllowed",
            "source",
            "license",
            "reviewNote"
