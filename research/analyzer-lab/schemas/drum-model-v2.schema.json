                "minLength": 1
              },
              "groupId": {
                "type": "string",
                "minLength": 1
              },
              "split": {
                "enum": [
                  "train",
                  "validation"
                ]
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "annotationHash": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "trackId",
              "groupId",
              "split",
              "contentHash",
              "annotationHash"
            ],
            "additionalProperties": false
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "annotationProvenance": {
          "type": "object"
        },
        "candidateCoverage": {
          "type": "object"
        },
        "trainingCandidates": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "datasetId",
        "rights",
        "tracks",
        "annotationProvenance",
        "candidateCoverage",
        "trainingCandidates"
      ],
      "additionalProperties": false
    },
    "environment": {
      "type": "object"
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "modelChecksum": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "basisNames": {
      "const": [
        "log_rms",
        "crest",
        "zero_crossings_per_second",
        "centroid_hz",
        "flatness",
        "tonal_concentration",
        "log_power_20_180",
        "log_power_180_1200",
        "log_power_1200_4000",
        "log_power_4000_11025",
