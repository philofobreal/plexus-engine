{
  "name": "plexus-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://philofobreal.github.io/plexus-engine/",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs tests/ui/*.test.mjs",
    "update-golden-masters": "bun scripts/generate-golden-masters.ts",
    "deploy": "bun run build && bun -e \"import { writeFileSync } from 'node:fs'; writeFileSync('dist/.nojekyll', '')\" && gh-pages -d dist"
  },
  "devDependencies": {
    "@types/p5": "^1.7.7",
    "@types/three": "^0.186.0",
    "@types/webxr": "^0.5.24",
    "gh-pages": "^6.3.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.12"
  },
  "dependencies": {
    "p5": "^2.2.3",
    "three": "^0.186.0"
  }
}
