    {
      "name": "every wormhole clip preset carries role keys explicitly and leaves user-global masters untouched",
      "message": "vos-wh-drift.json must not reset user-global wormholeStarfield",
      "matchesBaseline": true
    },
    {
      "name": "all presets stay visible and ring quantization is limited to authored ring roles",
      "message": "establish remains visibly above the opacity floor",
      "matchesBaseline": true
    },
    {
      "name": "weak roles pin a deep-perspective depth and continuity profile",
      "message": "establish depth\n\n2.03136 !== 4",
      "matchesBaseline": true
    },
    {
      "name": "clip roles have materially different wormhole behaviour (role-level contrast)",
      "message": "deep drift deeper than establish",
      "matchesBaseline": true
    },
    {
      "name": "factory preset pairs preserve their authored near/far projected tunnel geometry",
      "message": "vos-wh-dissolve.json/vos-wh-drift.json projected scale contrast 0.580/0.492",
      "matchesBaseline": true
    },
    {
      "name": "wormhole factory presets keep a minimum normalized weighted separation",
      "message": "vos-wh-drift.json / vos-wh-establish.json distance 0.073388 is below 0.09",
      "matchesBaseline": true
    },
    {
      "name": "wormhole preset speeds retain the authored dramaturgical ordering",
      "message": "The expression evaluated to a falsy value:\n\n  assert.ok(role('dissolve') > role('drift'))",
      "matchesBaseline": true
    },
    {
